# ══════════════════════════════════════════════════
# Photobooth — Environment Variables Template
# Copy this file to .env.local and fill in your values
# ══════════════════════════════════════════════════

# Supabase Project URL
# Found in: Dashboard → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon / Publishable Key (safe for browser)
# Found in: Dashboard → Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY — never expose to browser)
# Found in: Dashboard → Settings → API → service_role secret
# Used for: Admin delete operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
